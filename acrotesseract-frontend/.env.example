# Copy to .env and fill in. Get the client IDs from https://console.cloud.google.com/
# (APIs & Services -> Credentials). Local and prod use separate OAuth clients, as in Olympos.
VITE_GOOGLE_CLIENT_ID_LOCAL=your-local-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID_PROD=your-prod-google-client-id.apps.googleusercontent.com
