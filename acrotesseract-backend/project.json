{
  "name": "acrotesseract-backend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "type:app",
    "lang:scala"
  ],
  "namedInputs": {
    "scala": [
      "{projectRoot}/build.sbt",
      "{projectRoot}/project/*.sbt",
      "{projectRoot}/project/build.properties",
      "{projectRoot}/modules/**/*.scala",
      "{workspaceRoot}/data/data.json"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "scala"
      ],
      "outputs": [
        "{projectRoot}/modules/lambda/target/scala-3.9.0/acrotesseract-lambda.jar"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "sbt lambda/assembly"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "scala"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "sbt test"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "sbt local/run"
      },
      "configurations": {
        "dynamodb": {
          "env": {
            "POSES_TABLE": "acrotesseract-poses-local",
            "TRANSITIONS_TABLE": "acrotesseract-transitions-local",
            "DYNAMODB_ENDPOINT": "http://localhost:8000",
            "AWS_REGION": "us-west-2",
            "AWS_ACCESS_KEY_ID": "local",
            "AWS_SECRET_ACCESS_KEY": "local"
          }
        }
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "prod",
      "options": {
        "cwd": "{projectRoot}",
        "command": "sbt \"local/runMain acrotesseract.seed\""
      },
      "configurations": {
        "prod": {
          "env": {
            "POSES_TABLE": "acrotesseract-poses-prod",
            "TRANSITIONS_TABLE": "acrotesseract-transitions-prod",
            "AWS_PROFILE": "acrotesseract-prod",
            "AWS_REGION": "us-west-2"
          }
        },
        "local": {
          "env": {
            "POSES_TABLE": "acrotesseract-poses-local",
            "TRANSITIONS_TABLE": "acrotesseract-transitions-local",
            "DYNAMODB_ENDPOINT": "http://localhost:8000",
            "AWS_REGION": "us-west-2",
            "AWS_ACCESS_KEY_ID": "local",
            "AWS_SECRET_ACCESS_KEY": "local"
          }
        }
      }
    }
  }
}
